# Port for the web server
PORT=3000

# MongoDB connection string. Local Docker example:
#   docker run -d --rm -p 27017:27017 --name bjpoker-mongo mongo:7
MONGO_URI=mongodb://localhost:27017/cardgame

# Secret for signing login tokens. Required. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# development or production (production sets the auth cookie to Secure, HTTPS only)
NODE_ENV=development
