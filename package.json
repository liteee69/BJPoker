{
  "name": "bjpoker",
  "version": "0.1.0",
  "description": "Multiplayer Blackjack and Texas Hold'em — OOP card game platform",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "build:css": "tailwindcss -i ./client/css/tailwind.src.css -o ./client/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./client/css/tailwind.src.css -o ./client/css/tailwind.css --watch",
    "test": "node --test --test-reporter=spec 'server/test/**/*.test.js'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "socket.io": "^4.7.5",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
